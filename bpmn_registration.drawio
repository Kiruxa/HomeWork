<mxfile host="app.diagrams.net"><diagram id="bpmn-registration" name="Регистрация"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pool" value="Регистрация по email и паролю в мобильном приложении" style="swimlane;html=1;horizontal=0;startSize=36;collapsible=0;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#e6e6e6;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1970" height="750" as="geometry"/></mxCell><mxCell id="lane_user" value="Пользователь" style="swimlane;html=1;horizontal=0;startSize=36;collapsible=0;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="36" y="0" width="1934" height="150" as="geometry"/></mxCell><mxCell id="lane_app" value="Мобильное приложение" style="swimlane;html=1;horizontal=0;startSize=36;collapsible=0;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="36" y="150" width="1934" height="150" as="geometry"/></mxCell><mxCell id="lane_api" value="Backend API" style="swimlane;html=1;horizontal=0;startSize=36;collapsible=0;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="36" y="300" width="1934" height="150" as="geometry"/></mxCell><mxCell id="lane_db" value="База данных" style="swimlane;html=1;horizontal=0;startSize=36;collapsible=0;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="pool"><mxGeometry x="36" y="450" width="1934" height="150" as="geometry"/></mxCell><mxCell id="lane_mail" value="Email-сервис" style="swimlane;html=1;horizontal=0;startSiz